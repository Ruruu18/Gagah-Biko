# Copy this file to .env and fill in your real sender credentials.
#
# Django deployment
SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Recommended free setup: Brevo transactional SMTP.
# 1. Create a free Brevo account.
# 2. Verify your sender email/domain in Brevo.
# 3. Copy the SMTP Login into EMAIL_HOST_USER.
# 4. Create an SMTP key and paste it as EMAIL_HOST_PASSWORD.
# 5. Use a verified sender email in DEFAULT_FROM_EMAIL.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=your-smtp-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=Gagah Home Made-Biko <verified-sender@yourdomain.com>

# Gmail fallback for local/small-site testing:
# 1. Turn on 2-Step Verification in your Google account.
# 2. Create an App Password for Mail.
# 3. Use that 16-character app password, not your normal Gmail password.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=20
# EMAIL_HOST_USER=youraddress@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=Gagah Home Made-Biko <youraddress@gmail.com>

# PayMongo Checkout
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_key_here
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_CURRENCY=PHP
