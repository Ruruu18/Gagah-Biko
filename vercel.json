{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "uv venv .venv && uv pip install --python .venv/bin/python -r requirements.txt",
  "buildCommand": ".venv/bin/python manage.py collectstatic --noinput",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ]
}
